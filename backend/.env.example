# Local development. Copy to backend/.env and edit.
DATABASE_URL=postgresql://tarajuu:tarajuu@localhost:5432/tarajuu
JWT_SECRET=dev-only-change-me

# Firebase project that the Flutter app signs in against (phone OTP + Google)
FIREBASE_PROJECT_ID=

# Amazon.in scraping (plain HTTP, no evasion)
AMAZON_ENABLED=true
AMAZON_PARTNER_TAG=

# Flipkart official Affiliate API (https://affiliate.flipkart.com)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Uber API (https://developer.uber.com). Scope "guests.trips" uses the Guest
# Rides estimates API; "ride_request.estimate" uses GET /v1.2/estimates/price.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SCOPE=guests.trips
