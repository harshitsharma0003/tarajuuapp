# Production settings on the VM. setup-vm.sh creates deploy/.env from this
# with generated secrets; fill in the blanks afterwards and re-run
#   docker compose up -d
# (Docker env files do not support inline comments — keep comments on their own line.)

# Auto-filled from the VM IP, e.g. 34-93-12-7.sslip.io
DOMAIN=
# Generated
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=*

FIREBASE_PROJECT_ID=

AMAZON_ENABLED=true
AMAZON_PARTNER_TAG=

FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SCOPE=guests.trips

CONTACT_EMAIL=support@tarajuu.app
